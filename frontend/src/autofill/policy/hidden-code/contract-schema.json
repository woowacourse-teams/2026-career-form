{
  "behavior": {
    "$object": {
      "conditionalStates": {
        "$array": {
          "$object": {
            "driver": "string",
            "code": "string",
            "label": "string",
            "controls": {
              "$array": {
                "$object": {
                  "id": "string",
                  "disabled": "boolean",
                  "required": "boolean",
                  "allowAbsent": "boolean"
                },
                "$required": ["id", "disabled", "allowAbsent"]
              }
            }
          },
          "$required": ["driver", "code", "label", "controls"]
        }
      },
      "dependencies": {
        "$array": {
          "$object": {
            "fields": {
              "$array": "string"
            },
            "driver": "string",
            "code": "string",
            "label": "string"
          },
          "$required": ["fields", "driver", "code", "label"]
        }
      },
      "rowKinds": {
        "$array": {
          "$object": {
            "section": "string",
            "code": "string",
            "valueField": "string",
            "value": "string"
          },
          "$required": ["section", "code"]
        }
      },
      "rowPreparation": {
        "$object": {
          "sectionOrder": {
            "$array": "string"
          },
          "selectionOrder": {
            "$enum": ["AFTER_ALL_ROWS", "BEFORE_NEXT_ROW"]
          },
          "revealTemplates": {
            "$array": {
              "$array": "string"
