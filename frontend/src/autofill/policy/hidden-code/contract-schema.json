          },
          "sourceCategory": {
            "$enum": [
              "education",
              "languages",
              "certifications",
              "careers",
              "projects",
              "publications",
              "health"
            ]
          },
          "selectSteps": {
            "$array": {
              "$enum": ["OPEN_TRIGGER", "CLICK_EXACT_OPTION", "WAIT_REVEALED"]
            }
          },
          "resetSteps": {
            "$array": {
              "$enum": ["OPEN_TRIGGER", "CLICK_RESET", "WAIT_EMPTY"]
            }
          },
          "rowSelector": "string",
          "groupSelector": "string",
          "resetCode": "string",
          "resetOptionCount": "number",
          "requireCompleteOptions": "boolean",
          "add": {
            "$object": {
              "sourcePosition": {
                "$enum": ["FIRST", "LAST"]
              },
              "resultPosition": {
                "$enum": ["FIRST", "LAST"]
              },
              "selector": "string",
              "reset": "boolean",
              "plan": "$plan"
            },
            "$required": [
              "sourcePosition",
              "resultPosition",
              "selector",
              "reset",
              "plan"
            ]
          },
          "alignment": {
            "$object": {
              "matchBy": {
                "$enum": ["POSITION", "KEY"]
              },
              "mismatch": {
                "$enum": ["REJECT", "PRESERVE"]
              },
              "empty": {
                "$enum": ["ASSIGN", "REJECT"]
              }
            },
            "$required": ["matchBy", "mismatch", "empty"]
          }
        },
        "$required": [
          "sectionOrder",
          "revealTemplates",
          "sourceCategory",
          "selectSteps",
          "resetSteps",
          "rowSelector",
          "groupSelector",
          "resetCode",
          "resetOptionCount",
          "requireCompleteOptions",
          "add",
          "alignment"
        ]
      },
      "groupKinds": {
        "$record": {
          "$tuple": ["string", "string"]
        }
      },
      "rowActions": {
        "$array": {
          "$object": {
            "id": "string",
