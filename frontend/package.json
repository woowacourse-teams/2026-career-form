{
  "name": "career-form-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "wxt build && node scripts/assert-build.mjs",
    "coverage": "vitest run --coverage",
    "dev": "wxt",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "wxt prepare && tsc --noEmit",
    "zip": "wxt zip && node scripts/assert-zip.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "adm-zip": "0.5.16",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.8.1",
    "globals": "16.5.0",
    "jsdom": "29.0.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wxt": "0.21.4"
  }
}
