[Unit]
Description=Career Form MongoDB encrypted backup
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/career-form/mongodb-backup.env
ExecStart=/usr/bin/python3 /opt/career-form/mongodb-backup/mongodb-backup.py --env-file /etc/career-form/mongodb-backup.env
UMask=0077
NoNewPrivileges=true
RuntimeDirectory=career-form-mongodb-backup
RuntimeDirectoryMode=0700
TimeoutStartSec=30min
