{
  "uid": "career-form-mongodb",
  "title": "Career Form MongoDB",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "career-form",
    "mongodb"
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "앱 환경",
        "type": "custom",
        "query": "dev,staging,prod",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          }
        ]
      },
      {
        "name": "requestId",
        "label": "HTTP requestId (정규식)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "수집과 DB 응답",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "scrape 실패와 DB 응답 실패를 구분합니다. 누락은 정상 또는 0이 아닙니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"mongodb|mongodb-host|mongodb-agent\",instance=\"career-db\"}",
          "legendFormat": "{{job}} scrape",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "mongodb_up{job=\"mongodb\",instance=\"career-db\"}",
          "legendFormat": "인증 포함 DB 응답",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "공용 CPU 사용률",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "career:mongodb:cpu_usage{instance=\"career-db\"}",
          "legendFormat": "공용 DB",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "공용 가용 메모리와 swap",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "career:mongodb:memory_available{instance=\"career-db\"}",
          "legendFormat": "가용 메모리 (%)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "DB 데이터 파일시스템 사용률",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "host-state가 실제 DB 데이터 디렉토리에서 읽은 파일시스템입니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "career:mongodb:data_usage{instance=\"career-db\"}",
          "legendFormat": "사용률 (%)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "MongoDB 서버 연결",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "서버 전체 연결이며 환경별 합계로 복제하지 않습니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "(mongodb_ss_connections{job=\"mongodb\",instance=\"career-db\",conn_type=~\"current|active|available\"}) and on(instance) (max by(instance) (time() - timestamp(mongodb_ss_connections{job=\"mongodb\",instance=\"career-db\",conn_type=~\"current|active|available\"})) < 90) and on(instance) (mongodb_up{job=\"mongodb\"} == 1)",
          "legendFormat": "{{conn_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "MongoDB 연결 생성률",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(mongodb_ss_connections{job=\"mongodb\",instance=\"career-db\",conn_type=\"totalCreated\"}[5m])) and on(instance) (max by(instance) (time() - timestamp(mongodb_ss_connections{job=\"mongodb\",instance=\"career-db\",conn_type=\"totalCreated\"})) < 90) and on(instance) (mongodb_up{job=\"mongodb\"} == 1)",
          "legendFormat": "초당 생성",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "DB별 데이터와 인덱스 용량",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(mongodb_dbstats_dataSize{job=\"mongodb\",env=\"$env\"}) and on(instance) (max by(instance) (time() - timestamp(mongodb_dbstats_dataSize{job=\"mongodb\",env=\"$env\"})) < 90) and on(instance) (mongodb_up{job=\"mongodb\"} == 1)",
          "legendFormat": "{{env}} 데이터",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(mongodb_dbstats_indexSize{job=\"mongodb\",env=\"$env\"}) and on(instance) (max by(instance) (time() - timestamp(mongodb_dbstats_indexSize{job=\"mongodb\",env=\"$env\"})) < 90) and on(instance) (mongodb_up{job=\"mongodb\"} == 1)",
          "legendFormat": "{{env}} 인덱스",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "(mongodb_dbstats_storageSize{job=\"mongodb\",env=\"$env\"}) and on(instance) (max by(instance) (time() - timestamp(mongodb_dbstats_storageSize{job=\"mongodb\",env=\"$env\"})) < 90) and on(instance) (mongodb_up{job=\"mongodb\"} == 1)",
          "legendFormat": "{{env}} 저장공간",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "WiredTiger 캐시와 dirty 데이터",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(mongodb_ss_wt_cache_bytes_currently_in_the_cache{job=\"mongodb\"}) and on(instance) (max by(instance) (time() - timestamp(mongodb_ss_wt_cache_bytes_currently_in_the_cache{job=\"mongodb\"})) < 90) and on(instance) (mongodb_up{job=\"mongodb\"} == 1)",
          "legendFormat": "사용",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(mongodb_ss_wt_cache_maximum_bytes_configured{job=\"mongodb\"}) and on(instance) (max by(instance) (time() - timestamp(mongodb_ss_wt_cache_maximum_bytes_configured{job=\"mongodb\"})) < 90) and on(instance) (mongodb_up{job=\"mongodb\"} == 1)",
          "legendFormat": "최대",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "(mongodb_ss_wt_cache_tracked_dirty_bytes_in_the_cache{job=\"mongodb\"}) and on(instance) (max by(instance) (time() - timestamp(mongodb_ss_wt_cache_tracked_dirty_bytes_in_the_cache{job=\"mongodb\"})) < 90) and on(instance) (mongodb_up{job=\"mongodb\"} == 1)",
          "legendFormat": "dirty",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "읽기와 쓰기 처리량",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(mongodb_ss_opcounters{job=\"mongodb\"}[5m])) and on(instance) (max by(instance) (time() - timestamp(mongodb_ss_opcounters{job=\"mongodb\"})) < 90) and on(instance) (mongodb_up{job=\"mongodb\"} == 1)",
          "legendFormat": "{{legacy_op_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "환경별 앱 풀",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "각 앱 인스턴스와 풀을 구분하며 idle은 사용 중으로 집계하지 않습니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "(career_form_mongo_pool_in_use{env=\"$env\"}) and on(env,instance,pool) (max by(env,instance,pool) (time() - timestamp(career_form_mongo_pool_in_use{env=\"$env\"})) < 90)",
          "legendFormat": "{{instance}} 풀 {{pool}} 사용 중",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(career_form_mongo_pool_idle{env=\"$env\"}) and on(env,instance,pool) (max by(env,instance,pool) (time() - timestamp(career_form_mongo_pool_idle{env=\"$env\"})) < 90)",
          "legendFormat": "{{instance}} 풀 {{pool}} 유휴",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "(career_form_mongo_pool_max{env=\"$env\"}) and on(env,instance,pool) (max by(env,instance,pool) (time() - timestamp(career_form_mongo_pool_max{env=\"$env\"})) < 90)",
          "legendFormat": "{{instance}} 풀 {{pool}} 최대",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "연결 대기와 timeout",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "P95는 최근 5분 20건 이상일 때 표시됩니다. timeout 건수는 낮은 표본에서도 표시됩니다. 시간은 초, timeout은 건입니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "career:mongodb:checkout_p95{env=\"$env\"}",
          "legendFormat": "{{instance}} 풀 {{pool}} P95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "career:mongodb:checkout_timeouts{env=\"$env\"}",
          "legendFormat": "{{instance}} 풀 {{pool}} timeout 5분 건수",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "DB 명령과 전체 호출 P95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "명령 왕복은 네트워크를 포함합니다. 전체 호출은 MongoTemplate 최상위 메서드의 반환까지이며 서버 내부 처리 시간과 다릅니다. stream/cursor 후속 소비는 별도 getMore 명령을 확인하세요.",
      "targets": [
        {
          "refId": "A",
          "expr": "career:mongodb:command_p95{env=\"$env\"}",
          "legendFormat": "{{instance}} 명령 {{command}} 왕복",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "career:mongodb:operation_p95{env=\"$env\"}",
          "legendFormat": "{{instance}} 작업 {{operation}} 전체",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "title": "명령 실패율과 표본",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "드라이버 명령 시도 기준이며 재시도가 포함될 수 있습니다. 명령 건수는 성공/실패/timeout 합계입니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "career:mongodb:command_failure_ratio{env=\"$env\"}",
          "legendFormat": "{{instance}} 실패율 (%)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum by(instance) (increase(career_form_mongo_command_seconds_count{env=\"$env\"}[5m]))) and on(instance) (max by(instance) (time() - timestamp(career_form_mongo_command_seconds_count{env=\"$env\"})) < 90)",
          "legendFormat": "{{instance}} 명령 건수",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "title": "디스크 I/O 지연",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "장치별 평균 요청 지연이며 쿼리 지연 또는 CPU iowait와 동일하지 않습니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "career:mongodb:io_read_seconds{instance=\"career-db\"}",
          "legendFormat": "{{device}} 읽기",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "career:mongodb:io_write_seconds{instance=\"career-db\"}",
          "legendFormat": "{{device}} 쓰기",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 15,
      "title": "캐시 eviction과 swap 활동",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(mongodb_ss_wt_cache_modified_pages_evicted{job=\"mongodb\"}[5m])) and on(instance) (max by(instance) (time() - timestamp(mongodb_ss_wt_cache_modified_pages_evicted{job=\"mongodb\"})) < 90) and on(instance) (mongodb_up{job=\"mongodb\"} == 1)",
          "legendFormat": "dirty eviction",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(rate(mongodb_ss_wt_cache_unmodified_pages_evicted{job=\"mongodb\"}[5m])) and on(instance) (max by(instance) (time() - timestamp(mongodb_ss_wt_cache_unmodified_pages_evicted{job=\"mongodb\"})) < 90) and on(instance) (mongodb_up{job=\"mongodb\"} == 1)",
          "legendFormat": "clean eviction",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "(rate(node_vmstat_pswpin{job=\"mongodb-host\"}[5m])) and on(instance) (max by(instance) (time() - timestamp(node_vmstat_pswpin{job=\"mongodb-host\"})) < 90)",
          "legendFormat": "swap in 페이지/초",
