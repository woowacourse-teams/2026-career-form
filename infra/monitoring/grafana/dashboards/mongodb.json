    {
      "id": 19,
      "title": "앱 DB 호출 로그",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 82,
        "w": 24,
        "h": 10
      },
      "description": "명령 시작 시 캡처한 HTTP requestId를 사용합니다. mongoRequestId는 별개의 드라이버 ID입니다. none은 background 작업입니다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"career-form-backend\",env=\"$env\"} |~ \"DB_(COMMAND|OPERATION|RESULT)\" | regexp \".*requestId=(?P<dbRequestId>[0-9a-fA-F-]{36}|none)\" | dbRequestId=~\"$requestId\"",
          "maxLines": 500,
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
