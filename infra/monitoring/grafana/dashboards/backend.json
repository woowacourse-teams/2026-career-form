{
  "uid": "career-form-monitoring",
  "title": "Career Form 운영 모니터링",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "custom",
        "query": "dev,staging,prod",
        "current": {
          "text": "dev",
          "value": "dev"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "host",
        "label": "호스트 (환경과 별도 선택)",
        "type": "custom",
        "query": "career-dev-staging,career-prod,career-monitor",
        "current": {
          "text": "career-dev-staging",
          "value": "career-dev-staging"
        },
        "options": [
          {
            "text": "career-dev-staging",
            "value": "career-dev-staging",
            "selected": true
          },
          {
            "text": "career-prod",
            "value": "career-prod",
            "selected": false
          },
          {
            "text": "career-monitor",
            "value": "career-monitor",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "status",
        "label": "조회 상태 코드 (빈 값: 미선택)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "requestId",
        "label": "관련 로그 requestId (빈 값: 미선택)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "API 요청 수 (최근 5분)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (increase(http_server_requests_seconds_count{env=\"$env\",uri!~\"/actuator/.*\"}[5m]))",
          "legendFormat": "{{uri}} {{instance}} {{provider}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "API 5xx 비율",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_server_requests_seconds_count{env=\"$env\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{env=\"$env\"}[5m]))",
          "legendFormat": "{{uri}} {{instance}} {{provider}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "API 평균 응답 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{env=\"$env\"}[5m])) / sum by (uri) (rate(http_server_requests_seconds_count{env=\"$env\"}[5m]))",
          "legendFormat": "{{uri}} {{instance}} {{provider}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "API p95 응답 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,uri) (rate(http_server_requests_seconds_bucket{env=\"$env\"}[5m])))",
          "legendFormat": "{{uri}} {{instance}} {{provider}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "JVM heap",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (jvm_memory_used_bytes{env=\"$env\",area=\"heap\"})",
          "legendFormat": "{{uri}} {{instance}} {{provider}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "GC 소요 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(jvm_gc_pause_seconds_sum{env=\"$env\"}[5m]))",
          "legendFormat": "{{uri}} {{instance}} {{provider}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "호스트 CPU (환경별 중복 집계 없음)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"host\",instance=\"$host\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{uri}} {{instance}} {{provider}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "호스트 메모리 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"host\",instance=\"$host\"} / node_memory_MemTotal_bytes{job=\"host\",instance=\"$host\"})",
          "legendFormat": "{{uri}} {{instance}} {{provider}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "호스트 루트 디스크 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"host\",instance=\"$host\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"host\",instance=\"$host\",mountpoint=\"/\"})",
          "legendFormat": "{{uri}} {{instance}} {{provider}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "외부 호출 평균 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider,operation) (rate(career_form_external_call_seconds_sum{env=\"$env\"}[5m])) / sum by (provider,operation) (rate(career_form_external_call_seconds_count{env=\"$env\"}[5m]))",
          "legendFormat": "{{uri}} {{instance}} {{provider}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "백엔드 scrape 상태",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"backend\",env=\"$env\"}",
          "legendFormat": "{{uri}} {{instance}} {{provider}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "선택 환경의 비식별 운영 로그",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"$env\",service=\"career-form-backend\"}"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 13,
      "title": "HTTP 상태 코드별 추이 (2xx 제외, 최근 5분)",
      "type": "timeseries",
      "description": "3xx는 리다이렉트이며 오류로 분류하지 않습니다. 상태 코드 링크로 요청 로그를 조회합니다. 신규 알림은 없습니다.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 48, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "sum by (status) (increase(http_server_requests_seconds_count{env=\"$env\",status=~\"[345][0-9]{2}\",uri!~\"/actuator(/.*)?\"}[5m]))", "legendFormat": "{{status}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {"title": "해당 코드 요청 로그", "url": "/d/career-form-monitoring?var-env=${env}&from=${__from}&to=${__to}&var-status=${__field.labels.status}&var-requestId=&viewPanel=21"}
          ]
        },
        "overrides": [
          {
            "matcher": {"id": "byRegexp", "options": "^3[0-9]{2}$"},
            "properties": [
              {
                "id": "color",
                "value": {"mode": "fixed", "fixedColor": "blue"}
              }
            ]
          },
          {
            "matcher": {"id": "byRegexp", "options": "^4[0-9]{2}$"},
            "properties": [
              {
                "id": "color",
                "value": {"mode": "fixed", "fixedColor": "orange"}
              }
            ]
          },
          {
            "matcher": {"id": "byRegexp", "options": "^5[0-9]{2}$"},
            "properties": [
              {
                "id": "color",
                "value": {"mode": "fixed", "fixedColor": "red"}
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 14,
      "title": "서버 오류 요청 (5xx)",
      "type": "logs",
      "description": "환경, 시간 범위를 따릅니다. 최대 500줄이며 전체 로그 건수가 아닙니다. requestId 링크로 관련 로그를 확인하세요.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 0, "y": 72, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "{env=\"$env\",service=\"career-form-backend\"} |= \"API_RESULT \" | regexp \"API_RESULT (?P<event>.*)\" | line_format \"{{.event}}\" | logfmt --strict | status=~\"5[0-9]{2}\" | __error__=\"\"", "maxLines": 500, "queryType": "range", "direction": "backward"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "maxDataPoints": 500,
      "options": {"showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true, "showCommonLabels": false}
    },
    {
      "id": 15,
      "title": "API 지연 기준 초과 요청",
      "type": "logs",
      "description": "환경, 시간 범위를 따릅니다. 최대 500줄이며 전체 로그 건수가 아닙니다. requestId 링크로 관련 로그를 확인하세요. 분석 API 20초, interaction 5초, 기타 2초 초과. Actuator 제외.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 12, "y": 72, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "{env=\"$env\",service=\"career-form-backend\"} |= \"API_RESULT \" | regexp \"API_RESULT (?P<event>.*)\" | line_format \"{{.event}}\" | logfmt --strict | route!~\"/actuator(/.*)?\" | ((route=~\"/api/v1/(preparation|fields)/analyze\" and durationMs > 20000) or (route=\"/api/v1/generic/interaction-decisions\" and durationMs > 5000) or (route!~\"/api/v1/(preparation|fields)/analyze|/api/v1/generic/interaction-decisions\" and durationMs > 2000)) | __error__=\"\"", "maxLines": 500, "queryType": "range", "direction": "backward"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "maxDataPoints": 500,
      "options": {"showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true, "showCommonLabels": false}
    },
    {
      "id": 16,
      "title": "외부 호출 실패와 timeout",
      "type": "logs",
      "description": "환경, 시간 범위를 따릅니다. 최대 500줄이며 전체 로그 건수가 아닙니다. requestId 링크로 관련 로그를 확인하세요.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 0, "y": 80, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "{env=\"$env\",service=\"career-form-backend\"} |= \"EXTERNAL_RESULT \" | regexp \"EXTERNAL_RESULT (?P<event>.*)\" | line_format \"{{.event}}\" | logfmt --strict | outcome=~\"failure|timeout\" | __error__=\"\"", "maxLines": 500, "queryType": "range", "direction": "backward"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "maxDataPoints": 500,
      "options": {"showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true, "showCommonLabels": false}
    },
    {
      "id": 17,
      "title": "외부 호출 성공 P95 (최근 15분 이동)",
      "type": "timeseries",
      "description": "성공 호출만 집계합니다. 호출 수와 표본 상태를 함께 확인하세요. 호출이 없으면 데이터 없음이며 0초가 아닙니다.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 48, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le,provider,operation) (rate(career_form_external_call_seconds_bucket{env=\"$env\",outcome=\"success\"}[15m]))) and on (provider,operation) (sum by (provider,operation) (increase(career_form_external_call_seconds_count{env=\"$env\",outcome=\"success\"}[15m])) > 0)", "legendFormat": "{{provider}} {{operation}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 18,
      "title": "외부 호출 결과별 건수 (최근 15분)",
      "type": "timeseries",
      "description": "success, failure, timeout을 구분합니다. counter 증가량의 추정값입니다.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 56, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "sum by (provider,operation,outcome) (increase(career_form_external_call_seconds_count{env=\"$env\"}[15m]))", "legendFormat": "{{provider}} {{operation}} {{outcome}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 19,
      "title": "외부 호출 성공 P95 표본 상태 (최근 15분)",
      "type": "stat",
      "description": "20건은 통계적 신뢰를 보장하지 않는 초기 표시 기준입니다. 관측 건수는 counter 증가량 추정값입니다.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 56, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "((sum by (provider,operation) (increase(career_form_external_call_seconds_count{env=\"$env\",outcome=\"success\"}[15m])) or (0 * sum by (provider,operation) (increase(career_form_external_call_seconds_count{env=\"$env\"}[15m])))) > bool 0) + ((sum by (provider,operation) (increase(career_form_external_call_seconds_count{env=\"$env\",outcome=\"success\"}[15m])) or (0 * sum by (provider,operation) (increase(career_form_external_call_seconds_count{env=\"$env\"}[15m])))) >= bool 20)", "legendFormat": "{{provider}} {{operation}}", "instant": true}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "데이터 없음",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "데이터 없음", "color": "gray"},
                "1": {"text": "표본 부족", "color": "orange"},
                "2": {"text": "표본 기준 충족", "color": "green"}
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 20,
      "title": "선택 요청의 관련 로그 (시간순)",
      "type": "logs",
      "description": "환경, 시간 범위를 따릅니다. 최대 500줄이며 전체 로그 건수가 아닙니다. requestId 링크로 관련 로그를 확인하세요. requestId 미선택 시 조회하지 않습니다. 오류, 지연, 상태 코드 조건을 적용하지 않습니다.",
