      {
        "name": "site",
        "label": "사이트",
        "type": "textbox",
        "query": "ALL",
        "current": {
          "text": "ALL",
          "value": "ALL"
        },
        "description": "ALL은 전체입니다. 사이트는 호스트 또는 사이트 식별자, 버전과 구조는 정확한 식별자로 조회합니다."
      },
      {
        "name": "version",
        "label": "버전",
        "type": "textbox",
        "query": "ALL",
        "current": {
          "text": "ALL",
