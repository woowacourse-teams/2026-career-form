        {
          "id": 34,
          "title": "DB 명령 응답 시간 · P50 / P95 / P99",
          "type": "timeseries",
          "gridPos": {
            "x": 0,
            "y": 39,
            "w": 24,
            "h": 6
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "description": "MongoDB 명령을 보내고 응답받기까지의 지연입니다. 전체 DB 작업 지연과 비교하여 원인을 살펴보세요.",
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.50, sum by(env,instance,command,le) (rate(career_form_mongo_command_seconds_bucket{job=\"backend\",env=\"$env\"}[5m]))) and on(env,instance,command) (sum by(env,instance,command) (increase(career_form_mongo_command_seconds_count{job=\"backend\",env=\"$env\"}[5m])) >= 20) and on(env,instance,command) (max by(env,instance,command) (time() - timestamp(career_form_mongo_command_seconds_count{job=\"backend\",env=\"$env\"})) < 90)",
              "legendFormat": "DB 명령 응답 ({{command}}) P50",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            },
            {
              "refId": "B",
              "expr": "histogram_quantile(0.95, sum by(env,instance,command,le) (rate(career_form_mongo_command_seconds_bucket{job=\"backend\",env=\"$env\"}[5m]))) and on(env,instance,command) (sum by(env,instance,command) (increase(career_form_mongo_command_seconds_count{job=\"backend\",env=\"$env\"}[5m])) >= 20) and on(env,instance,command) (max by(env,instance,command) (time() - timestamp(career_form_mongo_command_seconds_count{job=\"backend\",env=\"$env\"})) < 90)",
              "legendFormat": "DB 명령 응답 ({{command}}) P95",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            },
