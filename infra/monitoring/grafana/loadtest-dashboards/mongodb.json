              "refId": "A",
              "expr": "(mongodb_ss_wt_cache_bytes_currently_in_the_cache{job=\"mongodb\"}) and on(instance) (max by(instance) (time() - timestamp(mongodb_ss_wt_cache_bytes_currently_in_the_cache{job=\"mongodb\"})) < 90) and on(instance) (mongodb_up{job=\"mongodb\"} == 1)",
