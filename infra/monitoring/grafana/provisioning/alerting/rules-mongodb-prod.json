{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "rules-mongodb-prod",
      "folder": "Career Form",
      "interval": "30s",
      "rules": [
        {
          "uid": "cf-db-prod-db-command-failure-warning",
          "title": "[prod] 최근 5분 DB 호출 실패율 (%) (warning)",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "career:mongodb:operation_failure_ratio{env=\"prod\"} * on(env,instance) (career:mongodb:operation_failures{env=\"prod\"} >= bool 3)",
                "instant": true,
                "range": false,
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gte",
                      "params": [
                        5
                      ]
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            }
          ],
          "noDataState": "KeepLast",
          "execErrState": "KeepLast",
          "for": "0s",
          "keepFiringFor": "5m",
          "missing_series_evals_to_resolve": 1051200,
          "isPaused": false,
          "labels": {
            "service": "mongodb-observation",
            "kind": "db-command-failure",
            "severity": "warning",
            "env": "prod"
          },
          "annotations": {
            "summary": "최근 5분 DB 호출 실패율 (%) | 현재 값 {{ if $values.A }}{{ printf \"%.3f\" $values.A.Value }}{{ else }}측정 불가{{ end }}",
            "description": "초기 기준 gte 5, 0s 지속. 정상 확인 5m 후 복구. 누락은 정상 복구가 아닙니다. 상세 단위와 조건은 패널을 확인하세요.",
            "__dashboardUid__": "career-form-mongodb",
            "__panelId__": "13"
          }
        },
        {
          "uid": "cf-db-prod-db-command-failure-critical",
          "title": "[prod] 최근 5분 DB 호출 실패율 (%) (critical)",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "prometheus",
