                },
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            }
          ],
          "noDataState": "KeepLast",
          "execErrState": "KeepLast",
          "for": "0s",
          "keepFiringFor": "5m",
          "missing_series_evals_to_resolve": 1051200,
          "isPaused": false,
          "labels": {
            "service": "mongodb-observation",
            "kind": "db-command-failure",
            "severity": "critical",
            "env": "prod"
          },
          "annotations": {
            "summary": "최근 5분 DB 호출 실패율 (%) | 현재 값 {{ if $values.A }}{{ printf \"%.3f\" $values.A.Value }}{{ else }}측정 불가{{ end }}",
            "description": "초기 기준 gte 20, 0s 지속. 정상 확인 5m 후 복구. 누락은 정상 복구가 아닙니다. 상세 단위와 조건은 패널을 확인하세요.",
            "__dashboardUid__": "career-form-mongodb",
            "__panelId__": "13"
          }
        },
        {
          "uid": "cf-db-prod-db-app-gap-warning",
          "title": "[prod] 앱 DB 계측 수집 중단 (초) (warning)",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max(time() - last_over_time(timestamp(career_form_mongo_pool_available{job=\"backend\",env=\"prod\"})[24h:30s])) or max(time() - career:mongodb:expected_start_timestamp_seconds)",
                "instant": true,
                "range": false,
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gte",
                      "params": [
                        180
                      ]
                    },
                    "unloadEvaluator": {
                      "type": "lte",
                      "params": [
                        60
                      ]
                    }
                  }
                ],
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            }
          ],
          "noDataState": "KeepLast",
          "execErrState": "KeepLast",
          "for": "0s",
          "keepFiringFor": "2m",
          "missing_series_evals_to_resolve": 1051200,
          "isPaused": false,
          "labels": {
            "service": "mongodb-observation",
            "kind": "db-app-gap",
            "severity": "warning",
            "env": "prod"
          },
          "annotations": {
            "summary": "앱 DB 계측 수집 중단 (초) | 현재 값 {{ if $values.A }}{{ printf \"%.3f\" $values.A.Value }}{{ else }}측정 불가{{ end }}",
