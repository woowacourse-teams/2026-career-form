{
  "component": {
    "selectors": {
      "field": "[data-scope=\"field\"][data-part=\"root\"]",
      "addressResults": "[data-scope=\"scroll-area\"][data-part=\"content\"]",
      "openDialog": "[role=\"dialog\"][data-scope=\"dialog\"][data-part=\"content\"][data-state=\"open\"]",
      "dialogClose": "[data-scope=\"dialog\"][data-part=\"close-trigger\"]",
      "unnamedEmail": "input[role=\"combobox\"][data-scope=\"combobox\"][data-part=\"input\"]:not([name])",
      "row": "[data-scope=\"accordion\"][data-part=\"item\"]",
      "fieldLabel": "label, [data-scope=\"field\"][data-part=\"label\"]",
      "radioGroup": "[data-scope=\"toggle-group\"][data-part=\"root\"][role=\"radiogroup\"]",
      "radioOption": "button[data-scope=\"toggle-group\"][data-part=\"item\"][role=\"radio\"]",
      "addTrigger": "button[data-scope=\"tooltip\"][data-part=\"trigger\"]",
      "section": "[data-scope=\"accordion\"][data-part=\"root\"]",
      "extraFields": "button[name], [data-scope=\"toggle-group\"][data-part=\"root\"][role=\"radiogroup\"]",
      "openSearchPopup": "[data-scope=\"scroll-area\"][data-part=\"viewport\"][role=\"presentation\"][data-state=\"open\"]",
      "scrollRoot": "[data-scope=\"scroll-area\"][data-part=\"root\"]",
      "searchPositioner": "[data-scope=\"combobox\"][data-part=\"positioner\"]",
      "checkedItem": "[data-part=\"item\"][role=\"option\"][data-state=\"checked\"]",
      "optionDetail": "[data-part=\"item-description\"]",
      "optionDecoration": "[data-part=\"item-description\"], [data-part=\"item-indicator\"]",
      "searchInput": "[data-scope=\"combobox\"][data-part=\"input\"][role=\"combobox\"][aria-controls]",
      "searchItem": "[data-scope=\"combobox\"][data-part=\"item\"]",
      "checkedSearchItem": "[data-scope=\"combobox\"][data-part=\"item\"][role=\"option\"][data-state=\"checked\"]",
      "codedSearchItem": "[data-scope=\"combobox\"][data-part=\"item\"][role=\"option\"][data-value]",
      "searchOption": "[data-scope=\"combobox\"][data-part=\"item\"][role=\"option\"]",
      "searchPopup": "[data-scope=\"scroll-area\"][data-part=\"viewport\"][role=\"presentation\"]",
      "choicePopup": "[role=\"listbox\"], [data-scope=\"scroll-area\"][data-part=\"viewport\"][role=\"presentation\"][data-state=\"open\"]",
      "calendarTrigger": "button[data-scope=\"date-picker\"][data-part=\"trigger\"][aria-controls]",
      "calendarPopup": "[data-scope=\"date-picker\"][data-part=\"content\"][role=\"application\"][aria-label=\"calendar\"]",
      "calendarInput": "input[data-scope=\"date-picker\"][data-part=\"input\"]",
      "calendarCells": "[data-scope=\"date-picker\"][data-part=\"table-cell-trigger\"][data-view]",
      "calendarClear": "[data-scope=\"date-picker\"][data-part=\"clear-trigger\"]",
      "calendarRoot": "[data-scope=\"date-picker\"][data-part=\"root\"]",
      "fieldGroup": "[data-scope=\"field\"][data-part=\"root\"][role=\"group\"]",
      "calendarValue": "[data-scope=\"date-picker\"][data-part=\"table-cell-trigger\"][data-view=\"{0}\"][data-value]",
      "collectedRadioOption": "button[role=\"radio\"][data-scope=\"toggle-group\"][data-part=\"item\"]"
    },
    "widget": {
      "optionCodeAttribute": "data-value",
      "calendarViewAttribute": "data-view",
      "monthView": "month",
      "dayView": "day",
      "stateAttribute": "data-state",
      "openState": "open",
      "monthSeparator": ". ",
      "daySeparator": ".",
      "monthLabelTemplate": "{year}년 {month}월",
      "placeholderAttributes": [
        "data-placeholder",
        "data-placeholder-shown"
      ],
      "searchPlaceholderAttribute": "data-placeholder-shown",
      "languagePlaceholder": "선택",
      "directCodeTemplate": "{code}-{value}",
      "popupRootDepth": 1,
      "popupPositionerDepth": 2,
      "ignorePositionerAriaHidden": true
    },
    "workflow": {
      "requireVerifiedMapping": true,
      "refreshAfterPass": true,
      "rebindReplacedControls": true,
      "captureDriverResults": true,
      "emailProfileKey": "contact.contact.email"
    },
    "emailBridge": {
      "selectors": {
        "field": "[data-scope=\"field\"][data-part=\"root\"]",
        "input": "input[role=\"combobox\"][data-scope=\"combobox\"][data-part=\"input\"]:not([name])",
        "row": "[data-scope=\"accordion\"][data-part=\"item\"]",
        "label": "label, [data-scope=\"field\"][data-part=\"label\"]",
        "confirmationField": "div[data-scope=\"field\"][data-part=\"root\"]",
        "popup": "div[role=\"presentation\"][data-scope=\"scroll-area\"][data-part=\"viewport\"]",
        "popupRoot": "div[data-scope=\"scroll-area\"][data-part=\"root\"]",
        "emptyPopup": "[data-empty]"
      },
      "commitMode": "FOCUS_INSERT_TEXT",
      "dismissMode": "ESCAPE_BLUR_OUTSIDE_POINTER",
      "allowHiddenConfirmationWithPopup": true,
      "settleMs": 150,
      "dismissTimeoutMs": 800,
      "ackTimeoutMs": 1000,
      "acceptanceTimeoutMs": 3000
    }
  },
  "hiddenCode": {
    "groupIdentity": {
