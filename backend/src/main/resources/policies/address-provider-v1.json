{
  "resultStrategy": "FIRST_RESULT",
  "selectors": {
    "input": "#region_name[name=region_name]",
    "query": "#cQuery",
    "trigger": "button.btn_search",
    "row": "li.list_post_item",
    "code": ".txt_postcode",
    "address": ".txt_addr",
    "result": "button.link_post:not(.link_english):not(.link_btn_map)",
    "paging": ".paging_post"
  },
  "postalAttribute": "data-zonecode",
  "firstPagePattern": "현재페이지\\s*1\\s*/\\s*[1-9][0-9]*(?:\\s|$)",
  "searchPlan": [
    {
      "target": "input",
      "op": "SET_VALUE",
      "value": "{value}"
    },
    {
      "target": "input",
      "op": "EVENT",
      "event": "input"
    },
    {
      "target": "input",
      "op": "EVENT",
      "event": "change"
    },
    {
      "target": "control",
      "op": "CLICK"
    }
  ],
  "searchMs": 8000,
  "commitMs": 5000,
  "pollMs": 100
}
