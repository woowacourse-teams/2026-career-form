        ],
        "path": "/mrs2/applicant/resume/writeResume",
        "formSelector": "form#frm",
        "rootSelector": "#wrapResume",
        "assetPaths": [
          "/mrs2/release/js/applicant/writeResume/writeResume.js",
          "/mrs2/release/js/applicant/writeResume/writeResumeTemplate.js"
        ],
        "maxFieldsRequests": 5,
        "sections": [
          {
            "id": "hplace-mrs2-basic-extra",
            "title": "기본정보 추가",
            "selector": "#wrapResume",
            "enabled": true,
            "anchors": [],
            "fields": [
              {
                "name": "hplace.mrs2.basic.chineseName",
                "rawName": "chineseName",
                "type": "text",
                "label": "한자명",
                "binding": {
                  "type": "DERIVED",
                  "recipe": "HANJA_FULL_NAME"
                },
                "maxLength": 32,
                "scopeSelector": "section.writeResume[data-code='11']"
              },
              {
                "name": "hplace.mrs2.basic.hopeSalary",
                "rawName": "hopeSalary",
                "type": "number",
                "label": "희망연봉",
                "binding": {
                  "type": "DIRECT",
                  "profileFieldKey": "compensation.compensation.desiredSalary"
                },
                "min": 0,
                "max": 210000000,
                "step": 1,
                "scopeSelector": "section.writeResume[data-code='11']"
              },
              {
                "name": "hplace.mrs2.basic.latestSalary",
                "rawName": "latestSalary",
                "type": "number",
                "label": "직전연봉",
                "binding": {
                  "type": "DIRECT",
                  "profileFieldKey": "compensation.compensation.previousSalary"
                },
                "min": 0,
                "max": 210000000,
                "step": 1,
                "scopeSelector": "section.writeResume[data-code='11']"
              },
              {
                "name": "hplace.mrs2.basic.militaryBranchCode",
                "rawName": "military.militaryBranchCode",
                "type": "select",
                "label": "군별",
                "binding": {
                  "type": "DIRECT",
                  "profileFieldKey": "military.military.militaryBranch"
                },
                "options": {
                  "육군": "01",
                  "해군": "02",
                  "공군": "03",
                  "해병": "04",
                  "전경": "05",
                  "의경": "06",
                  "해경": "07",
                  "공익": "08",
                  "병역특례": "09",
                  "카투사": "10",
                  "의무소방": "11",
                  "기타": "99"
                },
                "scopeSelector": "section.writeResume[data-code='13']"
              },
              {
                "name": "hplace.mrs2.basic.militaryRole",
                "rawName": "military.militaryRole",
                "type": "text",
                "label": "병과",
                "binding": {
                  "type": "DIRECT",
                  "profileFieldKey": "military.military.militarySpecialty"
                },
                "maxLength": 64,
                "scopeSelector": "section.writeResume[data-code='13']"
              }
            ]
          },
          {
            "id": "hplace-mrs2-career",
            "title": "경력",
            "selector": "section.writeResume[data-code='16'] > .subject[data-code='153'][data-wrap='career']",
            "enabled": true,
            "anchors": ["hplace.mrs2.career.careerCriteriaCodeSn"],
            "rows": {
              "selector": ":scope > .loop[data-loop='career']",
              "namePrefix": "career",
              "groupId": "hplace.mrs2.career",
              "maxCount": 20
            },
            "action": {
              "id": "hplace.mrs2.career.add",
              "selector": "button[type='button'][data-button='add']",
              "label": "경력 추가",
              "categoryId": "careers",
              "profileSectionId": "career"
            },
            "fields": [
              {
                "name": "hplace.mrs2.career.careerCriteriaCodeSn",
                "rawName": "career[{index}].careerCriteriaCodeSn",
                "type": "select",
                "label": "고용형태",
                "binding": {
                  "type": "DIRECT",
                  "profileFieldKey": "careers.career.employmentType"
                },
                "dynamicOptions": {
                  "labels": [
                    "정규직",
                    "계약직",
                    "파견직",
                    "프리랜서",
                    "개인사업",
                    "병역특례",
                    "인턴",
                    "아르바이트",
                    "기타"
                  ],
                  "codeFormat": "POSITIVE_INTEGER"
                },
                "driver": {
                  "stage": 1,
                  "timeoutMs": 1000,
                  "dependencies": [
                    "hplace.mrs2.career.company",
                    "hplace.mrs2.career.entranceDate",
                    "hplace.mrs2.career.workingStatusCode",
                    "hplace.mrs2.career.department",
                    "hplace.mrs2.career.position",
                    "hplace.mrs2.career.assignedTask",
                    "hplace.mrs2.career.retirementReason"
                  ],
                  "settled": [
                    {
                      "field": "hplace.mrs2.career.company",
                      "state": "enabled"
                    },
                    {
                      "field": "hplace.mrs2.career.entranceDate",
                      "state": "enabled"
                    },
                    {
                      "field": "hplace.mrs2.career.workingStatusCode",
                      "state": "enabled"
                    },
                    {
                      "field": "hplace.mrs2.career.department",
                      "state": "enabled"
                    },
                    {
                      "field": "hplace.mrs2.career.position",
                      "state": "enabled"
                    },
                    {
                      "field": "hplace.mrs2.career.assignedTask",
                      "state": "enabled"
                    },
                    {
                      "field": "hplace.mrs2.career.retirementReason",
                      "state": "enabled"
                    }
                  ]
                }
              },
              {
                "name": "hplace.mrs2.career.company",
                "rawName": "career[{index}].company",
                "type": "text",
                "label": "회사명",
                "binding": {
                  "type": "DIRECT",
                  "profileFieldKey": "careers.career.companyName"
                },
                "maxLength": 128
              },
              {
                "name": "hplace.mrs2.career.entranceDate",
                "rawName": "career[{index}].entranceDate",
                "type": "text",
                "label": "입사일",
                "binding": {
                  "type": "DIRECT",
                  "profileFieldKey": "careers.career.startDate"
                },
                "date": {
                  "group": "career[{index}].careerDate",
                  "role": "START",
                  "formats": ["YM", "YMD"],
                  "peer": "hplace.mrs2.career.leavingDate",
                  "forbiddenAfterToday": true
                }
              },
              {
                "name": "hplace.mrs2.career.leavingDate",
                "rawName": "career[{index}].leavingDate",
                "type": "text",
                "label": "퇴사일",
                "binding": {
                  "type": "DIRECT",
                  "profileFieldKey": "careers.career.endDate"
                },
                "date": {
                  "group": "career[{index}].careerDate",
                  "role": "END",
                  "formats": ["YM", "YMD"],
                  "peer": "hplace.mrs2.career.entranceDate",
                  "forbiddenAfterToday": true
                }
              },
              {
                "name": "hplace.mrs2.career.workingStatusCode",
                "rawName": "career[{index}].workingStatusCode",
                "type": "radio",
                "label": "재직상태",
                "binding": {
                  "type": "DIRECT",
                  "profileFieldKey": "careers.career.employmentStatus"
                },
                "options": {
                  "재직중": "WORK",
                  "퇴사": "LEAVE"
                },
                "driver": {
                  "stage": 2,
                  "timeoutMs": 1000,
                  "dependencies": ["hplace.mrs2.career.leavingDate"],
                  "settled": [
                    {
                      "field": "hplace.mrs2.career.leavingDate",
                      "state": "enabled",
                      "whenLabel": "퇴사"
                    },
                    {
                      "field": "hplace.mrs2.career.leavingDate",
