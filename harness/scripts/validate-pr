#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from harness.lib.cli import nested_payload, print_result, read_json
from harness.lib.pr_contract import validate_pr


def main() -> int:
    if len(sys.argv) != 2:
        print("사용법: validate-pr <GitHub 이벤트 JSON>", file=sys.stderr)
        return 2
    try:
        payload = nested_payload(read_json(sys.argv[1]), "pull_request")
    except ValueError as error:
        print(error, file=sys.stderr)
        return 2
    return print_result(validate_pr(payload))


if __name__ == "__main__":
    raise SystemExit(main())
